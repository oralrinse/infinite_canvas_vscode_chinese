{
  "name": "infinite-canvas",
  "displayName": "Infinite Canvas 无限画布",
  "description": "功能强大的 VS Code 可视化画布编辑器，完全兼容 Obsidian Canvas。支持创建无限思维导图、图表和可视化工作流，内置 AI 内容生成与 Markdown 支持。",
  "version": "0.1.5",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Notebooks"
  ],
  "icon": "icon.png",
  "keywords": [
    "obsidian",
    "obsidian-canvas",
    "canvas",
    "visual",
    "mind map",
    "diagram",
    "knowledge management",
    "note taking",
    "pkm",
    "ai",
    "markdown",
    "graph",
    "visualization",
    "workflow",
    "中文",
    "无限画布",
    "思维导图",
    "白板",
    "whiteboard"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:infinite-canvas.canvasEditor",
    "onLanguage:canvas"
  ],
  "contributes": {
    "languages": [
      {
        "id": "canvas",
        "aliases": ["Canvas", "canvas"],
        "extensions": [".canvas"],
        "mimetypes": ["application/json"],
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "infinite-canvas.canvasEditor",
        "displayName": "无限画布",
        "selector": [
          {
            "filenamePattern": "*.canvas"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.canvas": "canvas"
      },
      "workbench.editorAssociations": {
        "*.canvas": "default"
      }
    },
    "commands": [
      {
        "command": "infinite-canvas.newCanvas",
        "title": "新建画布",
        "category": "无限画布"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "infinite-canvas.newCanvas",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "无限画布",
      "properties": {
        "infinite-canvas.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "用于 AI 智能生成想法的 OpenRouter API 密钥（可选，未提供时使用模拟响应）",
          "markdownDescription": "用于 AI 智能生成想法的 OpenRouter API 密钥。可在 [openrouter.ai](https://openrouter.ai) 免费获取。若未提供，扩展将使用模拟响应。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oralrinse/infinite_canvas_vscode_chinese"
  },
  "homepage": "https://github.com/oralrinse/infinite_canvas_vscode_chinese#readme",
  "bugs": {
    "url": "https://github.com/oralrinse/infinite_canvas_vscode_chinese/issues"
  },
  "publisher": "oralrinse",
  "license": "MIT",
  "author": {
    "name": "oralrinse"
  },
  "galleryBanner": {
    "color": "#2D3748",
    "theme": "dark"
  }
}